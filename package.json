  "scripts": {
    "start": "node app.js",
    "verify": "node scripts/verify.js"
  },
  "keywords": [
    "color",
    "colour",
    "mixer",
    "palette",
    "kubelka-munk",
    "oklab",
    "copic",
    "faber-castell",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "morgan": "^1.10.0"
  }
}
